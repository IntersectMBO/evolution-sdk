{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": [
    "test/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "test/**/*.json"
  ],
  "references": [
    {
      "path": "tsconfig.src.json"
    }
  ],
  "compilerOptions": {
    "tsBuildInfoFile": ".tsbuildinfo/test.tsbuildinfo",
    "outDir": ".tsbuildinfo/test",
    "noEmit": true,
    "paths": {
      "@evolution-sdk/review": [
        "./src/index.ts"
      ],
      "@evolution-sdk/review/*": [
        "./src/*/index.ts",
        "./src/*.ts"
      ]
    },
    "types": [
      "node"
    ]
  }
}
